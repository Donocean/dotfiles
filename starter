#!/bin/bash
set -e

# 脚本接受两个参数
IS_ARM=${1:-"no"}             # 第一个参数是否ARM架构（默认no）
INSTALL_ULAUNCHER=${2:-"no"}  # 第二个参数是否安装ulauncher（默认no）

# 显示参数状态
echo "当前配置："
echo "· 架构模式：$([ "$IS_ARM" = "arm" ] && echo "ARM" || echo "x86_64")"
echo "· 是否安装Ulauncher：$([ "$INSTALL_ULAUNCHER" = "yes" ] && echo "是" || echo "否")"

# link all dotfiles in the  $HOME/dotfiles
shopt -s dotglob
for file in "$HOME/dotfiles"/*; do
  if [ -f "$file" ]; then
    filename=$(basename "$file")
    if [ "$filename" != "starter" ]; then
        # 添加存在性检查
        if [ ! -e "$HOME/$filename" ]; then
            ln -s "$file" "$HOME/$filename"
            echo "Created symlink: $HOME/$filename -> $file"
        else
            echo "Skipping $filename: already exists in $HOME"
        fi
    fi
  fi
done
shopt -u dotglob

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# (only for Ubuntu)
if grep -q '^ID=ubuntu$' /etc/os-release; then
    # install fzf
    if [ ! -d "$HOME/.fzf" ]; then
        git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
        yes | ~/.fzf/install
        sudo apt install -y fzf
    else
        echo "fzf already installed, skipping..."
    fi

    # install ripgrep
    if ! command_exists rg; then
        sudo apt install -y ripgrep
    else
        echo "ripgrep already installed, skipping..."
    fi

    # intall fd-find
    if ! command_exists fdfind; then
        sudo apt install -y fd-find
    else
        echo "fd-find already installed, skipping..."
    fi

    # intall vifm
    if ! command_exists vifm; then
        sudo apt install -y vifm
    else
        echo "vifm already installed, skipping..."
    fi

    # install tmux
    if ! command_exists tmux; then
        sudo apt install -y tmux
    else
        echo "tmux already installed, skipping..."
    fi

    # clone my nvim configuration
    if [ ! -d "$HOME/.config/nvim" ]; then
        git clone https://github.com/Donocean/nvim.git ~/.config/nvim
    else
        echo "nvim config already exists, skipping..."
    fi

    # clone my vifm configuration
    if [ ! -d "$HOME/.config/vifm" ]; then
        git clone https://github.com/Donocean/vifm.git ~/.config/vifm
    else
        echo "vifm config already exists, skipping..."
    fi

    # install neovim for x86_64 arch
    if ! command_exists nvim; then
        # this is version is only work for x86 arch.
        # For other version please fllow https://github.com/neovim/neovim/blob/master/INSTALL.md#install-from-source
        # Note that the plugin mason.nvim is not support clangd and clang-format for rk3588(may be arm64?)
        # please use the 'apt' to install the 'clangd' and 'clang-format-18', then you need to make a empty directory
        # called 'clangd' and 'clang-format' in [~/.local/share/nvim/mason/packages/] to cheat mason that plugin has already been installed
        # intall vifm

        # install build prerequisites
        if [ "$IS_ARM" = "arm" ]; then
            echo "Installing Neovim for arm..."
            if ! command_exists ninja; then
                sudo apt install -y ninja-build
            else
                echo "ninja already installed, skipping..."
            fi
            if ! command_exists gettext; then
                sudo apt install -y gettext
            else
                echo "gettext already installed, skipping..."
            fi
            if ! command_exists cmake; then
                sudo apt install -y cmake
            else
                echo "cmake already installed, skipping..."
            fi
            if ! command_exists curl; then
                sudo apt install -y curl
            else
                echo "curl already installed, skipping..."
            fi
            if ! command_exists git; then
                sudo apt install -y git
            else
                echo "git already installed, skipping..."
            fi
            sudo apt install -y build-essential
            sudo apt install -y python3.8-venv #for mason

            temp_dir="$HOME/neovim"
            git clone https://github.com/neovim/neovim "$temp_dir" -b v0.10.3
            cd "$temp_dir" && make -j"$(nproc)" CMAKE_BUILD_TYPE=RelWithDebInfo
            sudo make install
            rm -rf "$temp_dir"
        else
            echo "Installing Neovim for x86_64..."
            nvim_path="$HOME/.local/bin/nvim"
            temp_file="$HOME/nvim-linux-x86_64.appimage"
            [ -f "$temp_file" ] && rm "$temp_file"

            if ! curl -L -o "$temp_file" https://github.com/neovim/neovim/releases/download/v0.10.3/nvim.appimage; then
                echo "Failed to download neovim, check network connection"
                exit 1
            fi

            chmod u+x "$temp_file"
            mkdir -p ~/.local/bin
            mv "$temp_file" "$nvim_path"
        fi
    else
        echo "neovim already installed, skipping..."
    fi

    # install ulauncher
    if [ "$INSTALL_ULAUNCHER" = "yes" ]; then
        if ! command_exists ulauncher; then
            sudo apt install -y software-properties-common
            sudo add-apt-repository universe -y
            sudo add-apt-repository ppa:agornostal/ulauncher -y
            sudo apt update
            sudo apt install -y ulauncher
        else
            echo "ulauncher already installed, skipping..."
        fi
    else
        echo "skipping Ulauncher installation"
    fi
fi

echo -e "\nall components are installed!"
